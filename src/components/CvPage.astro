---
/*
  CvPage: currículum en /cv (es) y /en/cv (en), con el estilo del portfolio.
  - Contenido en src/i18n/cv.ts. Por privacidad solo muestra LinkedIn (sin teléfono ni correo).
  - Estilos de impresión A4: el mismo HTML genera los PDF descargables (pnpm cv:pdf).
*/
import { Icon } from "astro-icon/components";
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "./ui/SiteHeader.astro";
import { profile } from "../data/profile";
import { getLang, homePaths, useTranslations } from "../i18n/translations";

const lang = getLang(Astro.currentLocale);
const cv = useTranslations(Astro.currentLocale).cv;
const linkedinDisplay = profile.links.linkedin.replace(/^https?:\/\/(www\.)?/, "").replace(/\/$/, "");
const sectionTitle = "cv-heading font-heading text-2xl md:text-3xl text-accent mb-5";
---

<BaseLayout title={cv.seoTitle} description={cv.seoDescription} titleKey="cv.seoTitle">
    <SiteHeader />

    <main
        id="main"
        tabindex="-1"
        class="cv-page outline-none min-h-svh px-[5%] pt-28 pb-20 bg-gradient-to-b from-secondary to-primary"
    >
        <article class="cv-sheet relative mx-auto max-w-4xl overflow-hidden rounded-2xl border border-accent/20 bg-secondary shadow-xl">
            <!-- Geek: barra de ventana -->
            <div class="when-geek cv-screen-only" aria-hidden="true">
                <div class="flex items-center gap-1.5 px-4 py-2 bg-geek-dark border-b border-accent/15">
                    <span class="w-2.5 h-2.5 rounded-full bg-[#ff5f56]"></span>
                    <span class="w-2.5 h-2.5 rounded-full bg-[#ffbd2e]"></span>
                    <span class="w-2.5 h-2.5 rounded-full bg-[#27c93f]"></span>
                    <span class="ml-2 font-mono text-xs text-fg-subtle">~/cv.md</span>
                </div>
            </div>

            <div class="p-6 sm:p-10 md:p-14">
                <!-- Encabezado -->
                <header class="flex flex-col gap-6 pb-8 border-b border-accent/15 md:flex-row md:items-end md:justify-between print:pb-3">
                    <div>
                        <p
                            class="font-mono text-xs tracking-[0.25em] uppercase text-fg-subtle mb-2"
                            data-i18n="cv.eyebrow"
                        >
                            {cv.eyebrow}
                        </p>
                        <h1 class="font-heading text-4xl md:text-5xl text-fg leading-tight">{profile.name}</h1>
                        <p class="mt-2 text-lg font-semibold text-accent" data-i18n="cv.role">
                            {cv.role}
                        </p>
                        <p class="mt-1 flex items-center gap-1.5 text-sm text-fg-muted">
                            <svg
                                class="w-4 h-4"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                aria-hidden="true"
                            >
                                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
                                <circle cx="12" cy="10" r="3" />
                            </svg>
                            <span data-i18n="cv.location">{cv.location}</span>
                        </p>
                        <!-- En el PDF el enlace se lee como texto -->
                        <p class="cv-print-only mt-1 text-sm text-fg-muted">{linkedinDisplay}</p>
                    </div>

                    <div class="cv-screen-only flex flex-wrap gap-3">
                        <a
                            href={profile.links.linkedin}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="inline-flex items-center gap-2 h-11 px-5 rounded-full border border-accent/40 text-fg font-bold text-sm transition-[scale,border-color] duration-200 hover:scale-105 hover:border-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
                            aria-label={cv.linkedinLabel}
                            data-i18n-attr="aria-label:cv.linkedinLabel"
                        >
                            <Icon name="logos:linkedin-icon" class="w-4 h-4" aria-hidden="true" />
                            LinkedIn
                        </a>
                        <a
                            href={cv.pdfUrl}
                            download
                            data-i18n-attr="href:cv.pdfUrl"
                            class="inline-flex items-center gap-2 h-11 px-5 rounded-full bg-accent text-primary font-bold text-sm transition-[scale,box-shadow] duration-200 hover:scale-105 hover:shadow-lg hover:shadow-accent/30 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-secondary"
                        >
                            <svg
                                class="w-4 h-4"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2.5"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                aria-hidden="true"
                            >
                                <path d="M12 3v12M7 10l5 5 5-5M5 21h14" />
                            </svg>
                            <span data-i18n="cv.download">{cv.download}</span>
                        </a>
                    </div>
                </header>

                <!-- Perfil -->
                <section class="cv-section pt-8" aria-labelledby="cv-profile">
                    <h2 id="cv-profile" class={sectionTitle} data-i18n="cv.sections.profile">
                        {cv.sections.profile}
                    </h2>
                    <div class="space-y-3 text-fg-muted leading-relaxed">
                        {cv.profile.map((paragraph, index) => (
                            <p data-i18n={`cv.profile.${index}`}>{paragraph}</p>
                        ))}
                    </div>
                </section>

                <!-- Experiencia -->
                <section class="cv-section pt-10" aria-labelledby="cv-experience">
                    <h2 id="cv-experience" class={sectionTitle} data-i18n="cv.sections.experience">
                        {cv.sections.experience}
                    </h2>
                    <div class="space-y-10">
                        {cv.jobs.map((job, jobIndex) => (
                            <article class="cv-job relative pl-5 border-l-2 border-accent/30">
                                <span
                                    class="absolute -left-[7px] top-2 w-3 h-3 rounded-full bg-accent"
                                    aria-hidden="true"
                                />
                                <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
                                    <h3 class="font-heading text-xl text-fg" data-i18n={`cv.jobs.${jobIndex}.title`}>
                                        {job.title}
                                    </h3>
                                    <p
                                        class="shrink-0 font-mono text-xs text-fg-subtle"
                                        data-i18n={`cv.jobs.${jobIndex}.period`}
                                    >
                                        {job.period}
                                    </p>
                                </div>
                                <p class="mt-1 text-sm">
                                    <span class="font-semibold text-accent" data-i18n={`cv.jobs.${jobIndex}.company`}>
                                        {job.company}
                                    </span>
                                    <span class="text-fg-subtle"> · </span>
                                    <span class="text-fg-subtle" data-i18n={`cv.jobs.${jobIndex}.place`}>
                                        {job.place}
                                    </span>
                                </p>
                                <ul class="cv-bullets mt-4 space-y-2.5 text-sm leading-relaxed text-fg-muted">
                                    {job.bullets.map((bullet, bulletIndex) => (
                                        <li
                                            data-i18n={`cv.jobs.${jobIndex}.bullets.${bulletIndex}`}
                                            set:html={bullet}
                                        />
                                    ))}
                                </ul>
                            </article>
                        ))}
                    </div>
                </section>

                <!-- Stack técnico -->
                <section class="cv-section pt-10" aria-labelledby="cv-stack">
                    <h2 id="cv-stack" class={sectionTitle} data-i18n="cv.sections.stack">
                        {cv.sections.stack}
                    </h2>
                    <div class="grid gap-6 md:grid-cols-2 print:grid-cols-2 print:gap-3">
                        {cv.stack.map((group, groupIndex) => (
                            <div>
                                <h3
                                    class="mb-3 font-mono text-xs tracking-widest uppercase text-highlight"
                                    data-i18n={`cv.stack.${groupIndex}.label`}
                                >
                                    {group.label}
                                </h3>
                                <ul class="flex flex-wrap gap-2">
                                    {group.items.map((item, itemIndex) => (
                                        <li
                                            class="cv-chip rounded-full border border-highlight/30 bg-primary px-3 py-1 font-mono text-xs text-highlight"
                                            data-i18n={`cv.stack.${groupIndex}.items.${itemIndex}`}
                                        >
                                            {item}
                                        </li>
                                    ))}
                                </ul>
                            </div>
                        ))}
                    </div>
                </section>

                <div class="grid gap-10 pt-10 md:grid-cols-2 print:grid-cols-2 print:gap-6">
                    <!-- Educación -->
                    <section class="cv-section" aria-labelledby="cv-education">
                        <h2 id="cv-education" class={sectionTitle} data-i18n="cv.sections.education">
                            {cv.sections.education}
                        </h2>
                        {cv.education.map((item, index) => (
                            <div>
                                <h3 class="font-heading text-lg text-fg" data-i18n={`cv.education.${index}.degree`}>
                                    {item.degree}
                                </h3>
                                <p class="mt-1 text-sm text-fg-muted">
                                    <span data-i18n={`cv.education.${index}.school`}>{item.school}</span> ·{" "}
                                    <span data-i18n={`cv.education.${index}.place`}>{item.place}</span>
                                </p>
                                <p class="mt-1 font-mono text-xs text-fg-subtle">{item.period}</p>
                            </div>
                        ))}
                    </section>

                    <!-- Certificaciones -->
                    <section class="cv-section" aria-labelledby="cv-certifications">
                        <h2 id="cv-certifications" class={sectionTitle} data-i18n="cv.sections.certifications">
                            {cv.sections.certifications}
                        </h2>
                        <ul class="space-y-3">
                            {cv.certifications.map((cert, index) => (
                                <li class="flex items-baseline justify-between gap-4 text-sm">
                                    <span>
                                        <span
                                            class="font-semibold text-fg"
                                            data-i18n={`cv.certifications.${index}.name`}
                                        >
                                            {cert.name}
                                        </span>
                                        <span class="text-fg-subtle"> · {cert.issuer}</span>
                                    </span>
                                    <span class="shrink-0 font-mono text-xs text-fg-subtle">{cert.year}</span>
                                </li>
                            ))}
                        </ul>
                    </section>
                </div>

                <!-- Más sobre mí -->
                <section class="cv-section pt-10" aria-labelledby="cv-more">
                    <h2 id="cv-more" class={sectionTitle} data-i18n="cv.sections.more">
                        {cv.sections.more}
                    </h2>
                    <dl class="grid gap-4 md:grid-cols-3 print:grid-cols-3 print:gap-2">
                        {cv.more.map((item, index) => (
                            <div class="rounded-xl border border-accent/15 bg-primary/60 p-4">
                                <dt class="font-semibold text-fg" data-i18n={`cv.more.${index}.label`}>
                                    {item.label}
                                </dt>
                                <dd
                                    class="mt-1 text-sm leading-relaxed text-fg-muted"
                                    data-i18n={`cv.more.${index}.text`}
                                >
                                    {item.text}
                                </dd>
                            </div>
                        ))}
                    </dl>
                </section>
            </div>
        </article>

        <p class="cv-screen-only mt-10 text-center">
            <a
                href={homePaths[lang]}
                data-route="home"
                class="inline-flex items-center gap-2 text-sm font-semibold text-fg-muted hover:text-fg transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded-full px-3 py-2"
            >
                <svg
                    class="w-4 h-4"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                >
                    <path d="M19 12H5M12 19l-7-7 7-7" />
                </svg>
                <span data-i18n="cv.back">{cv.back}</span>
            </a>
        </p>
    </main>
</BaseLayout>

<style>
    /* Viñetas con el color de acento */
    .cv-bullets > :global(li) {
        position: relative;
        padding-left: 1.1rem;
    }

    .cv-bullets > :global(li)::before {
        content: "";
        position: absolute;
        left: 0;
        top: 0.6em;
        width: 0.4rem;
        height: 0.4rem;
        border-radius: 9999px;
        background: var(--color-accent);
    }

    .cv-bullets :global(strong) {
        color: var(--color-fg);
        font-weight: 600;
    }

    /* Classroom: hoja de papel; el margen rojo solo cuando hay relleno suficiente (no cruza el texto en móvil) */
    :global([data-theme="classroom"]) .cv-sheet {
        background-color: #fffdf7;
    }

    @media (min-width: 640px) {
        :global([data-theme="classroom"]) .cv-sheet {
            background-image: linear-gradient(
                90deg,
                transparent 2rem,
                rgba(220, 38, 38, 0.18) 2rem,
                rgba(220, 38, 38, 0.18) calc(2rem + 1px),
                transparent calc(2rem + 1px)
            );
        }
    }

    /* Geek: ventana de terminal */
    :global([data-theme="geek"]) .cv-sheet {
        background: var(--color-geek-black);
    }

    .cv-print-only {
        display: none;
    }

    /* ---- Impresión / PDF (A4, siempre en claro y sin elementos de navegación) ---- */
    @media print {
        @page {
            size: A4;
            margin: 12mm 13mm;
        }

        :global(html[data-theme]) {
            color-scheme: light;
            --color-primary: #ffffff;
            --color-secondary: #ffffff;
            --color-accent: #1d4ed8;
            --color-highlight: #15803d;
            --color-fg: #111827;
            --color-fg-muted: #374151;
            --color-fg-subtle: #4b5563;
            --font-heading: var(--font-serif);
        }

        :global(body) {
            background: #ffffff !important;
            font-size: 10.5pt;
        }

        :global(header.fixed),
        :global(a[href="#main"]),
        :global([data-anim="progress"]),
        .cv-screen-only {
            display: none !important;
        }

        .cv-print-only {
            display: block;
        }

        .cv-page {
            min-height: 0;
            padding: 0 !important;
            background: none !important;
        }

        .cv-sheet {
            max-width: none;
            border: 0;
            border-radius: 0;
            box-shadow: none;
            background: #ffffff !important;
        }

        .cv-sheet > div {
            padding: 0 !important;
        }

        .cv-job,
        .cv-bullets > :global(li),
        .cv-section h3 {
            break-inside: avoid;
        }

        .cv-heading {
            break-after: avoid;
        }

        .cv-chip {
            background: #f8fafc !important;
            padding: 1px 7px !important;
            font-size: 7.5pt !important;
        }

        /* Versión compacta: el PDF cabe en 2 páginas */
        :global(body) {
            font-size: 9.5pt;
            line-height: 1.4;
        }

        .cv-sheet h1 {
            font-size: 22pt;
        }

        .cv-heading {
            font-size: 13.5pt;
            margin-bottom: 5px;
        }

        .cv-section {
            padding-top: 10px !important;
        }

        .cv-sheet p,
        .cv-sheet li,
        .cv-sheet dd {
            font-size: 9.5pt;
            line-height: 1.4;
        }

        .cv-sheet :global(.space-y-3) > :global(* + *) {
            margin-top: 4px;
        }

        .cv-sheet :global(.space-y-10) > :global(* + *) {
            margin-top: 10px;
        }

        .cv-bullets {
            margin-top: 4px !important;
        }

        .cv-bullets > :global(li + li) {
            margin-top: 2px !important;
        }

        .cv-job h3,
        .cv-section h3 {
            font-size: 11pt;
        }

        /* Etiquetas del stack: pequeñas, como en pantalla */
        .cv-section h3.font-mono {
            font-size: 7.5pt;
            margin-bottom: 4px;
        }

        .cv-sheet dl > div {
            padding: 6px 8px;
        }
    }
</style>
