---
import { Icon } from "astro-icon/components";
import Logo from "../ui/Logo.astro";
import { cvPaths, getLang, useTranslations } from "../../i18n/translations";
import { profile } from "../../data/profile";
const lang = getLang(Astro.currentLocale);
const t = useTranslations(Astro.currentLocale);

// Por privacidad no se publica el correo: el contacto va por LinkedIn, GitHub y el CV
const LINKEDIN = profile.links.linkedin;
const GITHUB = profile.links.github;

const buttonClass =
    "inline-flex items-center justify-center gap-3 h-14 w-full px-6 rounded-full font-bold border transition-[scale,background-color,border-color,box-shadow] duration-300 hover:scale-105 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-primary";
---

<section id="contact" class="py-24 px-[5%] bg-gradient-to-b from-primary to-secondary">
    <div class="max-w-2xl mx-auto text-center">
        <h2
            data-anim="title"
            data-i18n="contact.title"
            class="relative inline-block text-4xl md:text-5xl text-accent mb-6 section-title-line"
        >
            {t.contact.title}
        </h2>

        <p data-anim="fade-up" data-i18n="contact.subtitle" class="text-fg-muted text-lg leading-relaxed mt-10 mb-12">
            {t.contact.subtitle}
        </p>

        <!-- Canales de contacto: LinkedIn y GitHub en fila, el CV destacado a todo el ancho -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 max-w-md mx-auto mb-16" data-anim="stagger">
            <a
                href={LINKEDIN}
                target="_blank"
                rel="noopener noreferrer"
                class={`${buttonClass} bg-secondary text-fg border-accent/30 hover:border-accent`}
                aria-label={t.contact.linkedinLabel}
                data-i18n-attr="aria-label:contact.linkedinLabel"
            >
                <Icon name="logos:linkedin-icon" class="w-5 h-5" aria-hidden="true" />
                LinkedIn
            </a>

            <a
                href={GITHUB}
                target="_blank"
                rel="noopener noreferrer"
                class={`${buttonClass} bg-secondary text-fg border-accent/30 hover:border-accent`}
                aria-label={t.contact.githubLabel}
                data-i18n-attr="aria-label:contact.githubLabel"
            >
                <Icon name="simple-icons:github" class="w-5 h-5" aria-hidden="true" />
                GitHub
            </a>

            <a
                href={cvPaths[lang]}
                data-route="cv"
                class={`${buttonClass} sm:col-span-2 bg-accent text-primary border-accent hover:shadow-lg hover:shadow-accent/30`}
            >
                <svg
                    class="w-5 h-5"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                >
                    <path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z" />
                    <path d="M14 3v6h6M8 13h8M8 17h5" />
                </svg>
                <span data-i18n="contact.cvButton">{t.contact.cvButton}</span>
            </a>
        </div>

        <!-- Footer -->
        <div class="border-t border-accent/10 pt-8 flex flex-col items-center gap-4">
            <Logo class="h-10 w-auto text-fg" idPrefix="logo-footer" />
            <p class="text-fg-subtle text-sm font-mono">
                &copy; {new Date().getFullYear()} Sneyder Leguía Arrieta —{" "}
                <span data-i18n="contact.builtWith">{t.contact.builtWith}</span>
            </p>
        </div>
    </div>
</section>
