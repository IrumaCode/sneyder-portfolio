---
/*
  ============================================
  SiteHeader
  ============================================
  Barra fija: logo · navegación por secciones · tema · idioma.
  - Desktop (≥1024px): enlaces visibles; la sección activa se marca con aria-current.
  - Enlaces a la portada del idioma (#seccion) y al CV; se actualizan al cambiar de idioma.
  - Móvil: botón de menú con panel desplegable (Escape o clic en enlace cierra).
  - Incluye el skip link para usuarios de teclado.
*/
import Logo from "./Logo.astro";
import ThemeSwitcher from "./ThemeSwitcher.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { cvPaths, getLang, homePaths, useTranslations } from "../../i18n/translations";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(Astro.currentLocale);
const sections = ["experience", "projects", "skills", "contact"] as const;
// Los enlaces apuntan a la portada del idioma (funcionan también desde /cv)
const currentPath = Astro.url.pathname.endsWith("/") ? Astro.url.pathname : `${Astro.url.pathname}/`;
const isCvPage = currentPath === cvPaths[lang];
const linkClass =
    "px-3 h-9 inline-flex items-center rounded-full text-fg-muted hover:text-fg hover:bg-accent/10 aria-[current=true]:bg-accent aria-[current=true]:text-primary aria-[current=page]:bg-accent aria-[current=page]:text-primary transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent";
---

<a
    href="#main"
    class="sr-only focus:not-sr-only focus:fixed focus:top-20 focus:left-4 focus:z-[70] focus:px-4 focus:py-2 focus:rounded-full focus:bg-accent focus:text-primary focus:font-bold"
    data-i18n="ui.skipToContent"
>
    {t.ui.skipToContent}
</a>

<header class="fixed top-4 inset-x-4 md:top-6 md:inset-x-6 z-50 flex items-center justify-between gap-2 pointer-events-none [&>*]:pointer-events-auto">
    <!-- Logo -->
    <a
        href={`${homePaths[lang]}#hero`}
        data-route="home"
        data-hash="#hero"
        class="control-pill px-3 sm:px-4 hover:scale-105"
        aria-label={t.ui.home}
        data-i18n-attr="aria-label:ui.home"
    >
        <Logo class="h-6 w-auto text-fg" idPrefix="logo-header" />
    </a>

    <!-- Navegación desktop -->
    <nav class="hidden lg:block" aria-label={t.ui.mainNav} data-i18n-attr="aria-label:ui.mainNav">
        <ul class="control-pill gap-1 px-1 text-sm font-semibold">
            {sections.map((id) => (
                <li>
                    <a
                        href={`${homePaths[lang]}#${id}`}
                        class={linkClass}
                        data-nav-link={id}
                        data-route="home"
                        data-hash={`#${id}`}
                        data-i18n={`nav.${id}`}
                    >
                        {t.nav[id]}
                    </a>
                </li>
            ))}
            <li>
                <a
                    href={cvPaths[lang]}
                    class={linkClass}
                    data-route="cv"
                    aria-current={isCvPage ? "page" : undefined}
                    data-i18n="nav.cv"
                >
                    {t.nav.cv}
                </a>
            </li>
        </ul>
    </nav>

    <div class="flex items-center gap-2">
        <ThemeSwitcher />
        <LanguageSwitcher />

        <!-- Menú móvil -->
        <button
            type="button"
            id="menu-toggle"
            class="control-pill w-11 justify-center lg:hidden text-accent"
            aria-expanded="false"
            aria-controls="mobile-menu"
            aria-label={t.ui.openMenu}
            data-i18n-attr="aria-label:ui.openMenu"
        >
            <svg
                class="w-5 h-5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                aria-hidden="true"
            >
                <path class="menu-line-top origin-center transition-transform" d="M4 7h16" />
                <path class="menu-line-mid transition-opacity" d="M4 12h16" />
                <path class="menu-line-bottom origin-center transition-transform" d="M4 17h16" />
            </svg>
        </button>
    </div>

    <nav
        id="mobile-menu"
        class="lg:hidden absolute top-14 right-0 w-56 rounded-2xl border border-accent/30 bg-secondary/95 backdrop-blur-md shadow-xl p-2"
        aria-label={t.ui.mainNav}
        data-i18n-attr="aria-label:ui.mainNav"
        hidden
    >
        <ul class="flex flex-col gap-1 text-base font-semibold">
            {sections.map((id) => (
                <li>
                    <a
                        href={`${homePaths[lang]}#${id}`}
                        class={`${linkClass} w-full h-11`}
                        data-nav-link={id}
                        data-route="home"
                        data-hash={`#${id}`}
                        data-i18n={`nav.${id}`}
                    >
                        {t.nav[id]}
                    </a>
                </li>
            ))}
            <li>
                <a
                    href={cvPaths[lang]}
                    class={`${linkClass} w-full h-11`}
                    data-route="cv"
                    aria-current={isCvPage ? "page" : undefined}
                    data-i18n="nav.cv"
                >
                    {t.nav.cv}
                </a>
            </li>
        </ul>
    </nav>
</header>

<script>
    import { cvPaths, homePaths, type Language } from "../../i18n/translations";

    const toggle = document.getElementById("menu-toggle");
    const menu = document.getElementById("mobile-menu");

    function setMenu(open: boolean): void {
        if (!toggle || !menu) return;
        menu.hidden = !open;
        toggle.setAttribute("aria-expanded", String(open));
    }

    toggle?.addEventListener("click", () => setMenu(menu?.hidden ?? false));
    menu?.addEventListener("click", (event) => {
        if ((event.target as HTMLElement).closest("a")) setMenu(false);
    });
    document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && menu && !menu.hidden) {
            setMenu(false);
            toggle?.focus();
        }
    });

    // Un toque fuera del menú (o del botón) lo cierra; también al cambiar tema o idioma
    document.addEventListener("pointerdown", (event) => {
        if (!menu || menu.hidden) return;
        const target = event.target as Node;
        if (!menu.contains(target) && !toggle?.contains(target)) setMenu(false);
    });
    window.addEventListener("themeChanged", () => setMenu(false));
    window.addEventListener("languageChanged", () => {
        setMenu(false);
        syncLocalizedLinks();
    });

    // Al cambiar de idioma sin recargar, los enlaces apuntan a la página del nuevo idioma
    function syncLocalizedLinks(): void {
        const lang: Language = document.documentElement.lang === "en" ? "en" : "es";
        document.querySelectorAll<HTMLAnchorElement>("[data-route]").forEach((link) => {
            const base = link.dataset.route === "cv" ? cvPaths[lang] : homePaths[lang];
            link.href = base + (link.dataset.hash ?? "");
        });
    }

    // Sección activa: la que ocupa la franja central del viewport
    const links = document.querySelectorAll<HTMLAnchorElement>("[data-nav-link]");
    const observer = new IntersectionObserver(
        (entries) => {
            entries.forEach((entry) => {
                if (!entry.isIntersecting) return;
                links.forEach((link) => {
                    const active = link.dataset.navLink === entry.target.id;
                    if (active) link.setAttribute("aria-current", "true");
                    else link.removeAttribute("aria-current");
                });
            });
        },
        { rootMargin: "-45% 0px -50% 0px" },
    );

    ["hero", "experience", "projects", "skills", "contact"].forEach((id) => {
        const section = document.getElementById(id);
        if (section) observer.observe(section);
    });
</script>

<style>
    #menu-toggle[aria-expanded="true"] .menu-line-top {
        transform: translateY(5px) rotate(45deg);
    }
    #menu-toggle[aria-expanded="true"] .menu-line-mid {
        opacity: 0;
    }
    #menu-toggle[aria-expanded="true"] .menu-line-bottom {
        transform: translateY(-5px) rotate(-45deg);
    }
</style>
