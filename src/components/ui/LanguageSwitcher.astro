---
/*
  LanguageSwitcher: interruptor único ES ⇄ EN (role="switch").
  Un clic alterna el idioma al instante; aria-checked = inglés activo.
*/
import { translations, defaultLang } from "../../i18n/translations";
const t = translations[defaultLang];
---

<button
    type="button"
    id="lang-switch"
    role="switch"
    aria-checked="false"
    aria-label={t.ui.languageSwitch}
    data-i18n-attr="aria-label:ui.languageSwitch"
    class="lang-switch control-pill gap-2 px-3 text-xs tracking-wider hover:border-accent"
>
    <span class="lang-es transition-colors" lang="es" aria-hidden="true">ES</span>
    <span class="relative w-10 h-6 rounded-full bg-accent/15 border border-accent/40 transition-colors" aria-hidden="true">
        <span class="lang-knob absolute top-0.5 left-0.5 w-[1.125rem] h-[1.125rem] rounded-full bg-accent shadow transition-[translate] duration-300 ease-out"></span>
    </span>
    <span class="lang-en transition-colors" lang="en" aria-hidden="true">EN</span>
</button>

<script>
import { translations, type Language, defaultLang } from "../../i18n/translations";

const STORAGE_KEY = "preferred-lang";
let currentLang: Language = defaultLang;

const toggle = document.getElementById("lang-switch") as HTMLButtonElement | null;

function initLanguage(): void {
    const saved = localStorage.getItem(STORAGE_KEY) as Language | null;
    if (saved === "es" || saved === "en") {
        currentLang = saved;
    } else {
        const browserLang = navigator.language.slice(0, 2);
        currentLang = browserLang === "en" ? "en" : "es";
    }
    updateUI();
    translatePage();
}

function updateUI(): void {
    document.documentElement.lang = currentLang;
    toggle?.setAttribute("aria-checked", String(currentLang === "en"));
}

function resolve(path: string, source: unknown): unknown {
    return path.split(".").reduce((obj: any, k) => obj?.[k], source);
}

function translatePage(): void {
    const t = translations[currentLang];

    // Contenido: data-i18n="ruta.al.texto"
    document.querySelectorAll("[data-i18n]").forEach(el => {
        const key = el.getAttribute("data-i18n");
        if (!key) return;
        const value = resolve(key, t);
        if (typeof value === "string") {
            if (value.includes("<")) {
                el.innerHTML = value;
            } else {
                el.textContent = value;
            }
        } else if (Array.isArray(value)) {
            el.innerHTML = value.map(line => `<p class="mb-2">${line}</p>`).join("");
        }
    });

    // Atributos: data-i18n-attr="aria-label:ruta.al.texto"
    document.querySelectorAll("[data-i18n-attr]").forEach(el => {
        const [attr, key] = (el.getAttribute("data-i18n-attr") ?? "").split(":");
        const value = key ? resolve(key, t) : undefined;
        if (attr && typeof value === "string") el.setAttribute(attr, value);
    });

    window.dispatchEvent(new CustomEvent("languageChanged", {
        detail: { lang: currentLang }
    }));
}

toggle?.addEventListener("click", () => {
    currentLang = currentLang === "es" ? "en" : "es";
    localStorage.setItem(STORAGE_KEY, currentLang);
    updateUI();
    translatePage();
});

document.addEventListener("DOMContentLoaded", initLanguage);
if (document.readyState !== "loading") {
    initLanguage();
}
</script>

<style>
    /* Idioma activo resaltado; la bolita se desliza a la derecha en inglés */
    .lang-switch .lang-es,
    .lang-switch[aria-checked="true"] .lang-en {
        color: var(--color-accent);
    }

    .lang-switch .lang-en,
    .lang-switch[aria-checked="true"] .lang-es {
        color: var(--color-fg-subtle);
    }

    .lang-switch[aria-checked="true"] .lang-knob {
        translate: 1rem 0;
    }
</style>
