---
/*
  FeaturedProjectCard
  Proyecto principal (Mesmeric ERP): tarjeta a todo el ancho.
  Es código privado de la empresa, así que no lleva enlace al repositorio.
*/
import { useTranslations } from "../../i18n/translations";

const t = useTranslations(Astro.currentLocale).projects;
const f = t.featured;
---

<article class="featured-project relative overflow-hidden rounded-2xl border border-accent/40 bg-secondary p-6 md:p-10 shadow-xl shadow-accent/10">
    <!-- Brillo decorativo -->
    <div
        class="absolute -top-24 -right-24 w-72 h-72 rounded-full bg-accent/10 blur-3xl pointer-events-none"
        aria-hidden="true"
    ></div>

    <div class="relative grid gap-8 lg:grid-cols-[1.4fr_1fr] lg:items-center">
        <div>
            <div class="flex flex-wrap items-center gap-3 mb-5">
                <span class="font-heading text-xl md:text-2xl text-accent leading-none">
                    <span class="when-classroom italic" data-i18n="projects.labels.featuredClassroom">
                        {t.labels.featuredClassroom}
                    </span>
                    <span class="when-geek tracking-wider" data-i18n="projects.labels.featuredGeek">
                        {t.labels.featuredGeek}
                    </span>
                </span>
                <span class="inline-flex items-center gap-1.5 text-[0.6875rem] font-bold tracking-widest uppercase px-3 py-1 rounded-full bg-fg text-primary">
                    <svg
                        class="w-3 h-3"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                    >
                        <rect x="4" y="11" width="16" height="10" rx="2" />
                        <path d="M8 11V7a4 4 0 0 1 8 0v4" />
                    </svg>
                    <span data-i18n="projects.privateBadge">{t.privateBadge}</span>
                </span>
            </div>

            <h3 class="font-heading text-3xl md:text-5xl text-fg mb-2" data-i18n="projects.featured.title">
                {f.title}
            </h3>
            <p class="text-accent font-semibold mb-1" data-i18n="projects.featured.subtitle">
                {f.subtitle}
            </p>
            <p class="text-sm text-fg-subtle font-mono mb-5" data-i18n="projects.featured.company">
                {f.company}
            </p>
            <p class="text-fg-muted leading-relaxed mb-6" data-i18n="projects.featured.description">
                {f.description}
            </p>

            <ul class="flex flex-wrap gap-2">
                {f.tech.map((item, index) => (
                    <li
                        class="text-xs px-3 py-1 rounded-full bg-primary text-highlight border border-highlight/30 font-mono"
                        data-i18n={`projects.featured.tech.${index}`}
                    >
                        {item}
                    </li>
                ))}
            </ul>
        </div>

        <!-- Mi rol -->
        <div class="rounded-xl border border-accent/20 bg-primary/60 p-5 md:p-6">
            <p class="font-heading text-xl text-fg mb-4" data-i18n="projects.featured.rolesTitle">
                {f.rolesTitle}
            </p>
            <ul class="space-y-3" data-anim="stagger">
                {f.roles.map((role, index) => (
                    <li class="flex gap-3 text-sm text-fg-muted leading-relaxed">
                        <span
                            class="mt-0.5 grid place-items-center shrink-0 w-5 h-5 rounded-full bg-highlight/15 text-highlight"
                            aria-hidden="true"
                        >
                            <svg
                                class="w-3 h-3"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="3"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            >
                                <path d="M20 6 9 17l-5-5" />
                            </svg>
                        </span>
                        <span data-i18n={`projects.featured.roles.${index}`}>{role}</span>
                    </li>
                ))}
            </ul>
            <p class="mt-5 pt-4 border-t border-accent/15 text-xs text-fg-subtle" data-i18n="projects.privateNote">
                {t.privateNote}
            </p>
        </div>
    </div>
</article>
