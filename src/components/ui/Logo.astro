---
/*
  Logo { SLA }: llaves de JetBrains Mono (degradado ligado al tema vía
  --logo-from / --logo-to) y letras de Playfair Display en currentColor.
  Sin fondo. Se inserta inline para heredar color y tema; cada instancia
  recibe un prefijo de id propio para no duplicar ids en la página.
*/
import slaSvg from "../../assets/brand/sla.svg?raw";

interface Props {
    class?: string;
    idPrefix: string;
}

const { class: className = "", idPrefix } = Astro.props;
const svg = slaSvg
    .replaceAll("sla-", `${idPrefix}-`)
    .replace("<svg ", `<svg class="${className}" aria-hidden="true" focusable="false" `);
---

<Fragment set:html={svg} />
