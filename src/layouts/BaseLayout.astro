---
// =============================================
// FRONTMATTER (Zona de javaScript del servidor)
// =============================================
// Aquí va la logica que se ejecuta en BUILDTIME, no en el navegador
// Similar a un controlador en de Symfony pero se ejecuta al compilar

import { getLang, homePaths, translations, type Language } from "../i18n/translations";

// Props: datos que recibe este componente (como párametros de Twig).
// Título y descripción salen de translations.seo según el idioma de la ruta.
interface Props {
    title?: string;
    description?: string;
    noindex?: boolean;
    /** Clave de translations para el título al cambiar de idioma (por defecto seo.title) */
    titleKey?: string;
}

const lang = getLang(Astro.currentLocale);
const seo = translations[lang].seo;
const { title = seo.title, description = seo.description, noindex = false, titleKey = "seo.title" } = Astro.props;

// Versiones alternativas de la página de inicio para hreflang
const alternates = (Object.keys(homePaths) as Language[]).map((code) => ({
    hreflang: code,
    href: new URL(homePaths[code], Astro.site).href,
}));
const alternateLocale = translations[lang === "es" ? "en" : "es"].seo.ogLocale;

// URLs absolutas a partir de `site` (astro.config.mjs): las redes sociales y Google
// ignoran rutas relativas en canonical / og:image
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL("/og-image.png", Astro.site).href;

// Importamos los estilos globales
import "../styles/global.css";

// Importamos la fuente instalada en el proyecto
import "@fontsource/playfair-display/400.css";
import "@fontsource/playfair-display/600.css";
import "@fontsource/playfair-display/700.css";
import "@fontsource/playfair-display/400-italic.css";
import "@fontsource/playfair-display/600-italic.css";
import "@fontsource/caveat/700.css";
import "@fontsource/poppins/400.css";
import "@fontsource/poppins/600.css";
import "@fontsource/poppins/700.css";
import "@fontsource/vt323";
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/700.css";

// Fuente del texto principal (LCP) de cada tema: se precarga solo la del tema activo
import playfairBoldUrl from "@fontsource/playfair-display/files/playfair-display-latin-700-normal.woff2?url";
import vt323Url from "@fontsource/vt323/files/vt323-latin-400-normal.woff2?url";
const heroFonts = { classroom: playfairBoldUrl, geek: vt323Url };
---

<!doctype html>
<html lang={lang} data-theme="classroom" data-title-key={titleKey}>
    <head>
        <meta charset="UTF-8" />

        <!-- Tema antes del primer pintado (preferencia guardada o la del sistema)
             y precarga de la fuente del hero de ese tema -->
        <script is:inline define:vars={{ heroFonts }}>
            (function () {
                var theme;
                try {
                    theme = localStorage.getItem("preferred-theme");
                } catch (e) {}
                if (theme === "manga") theme = "geek";
                if (theme !== "classroom" && theme !== "geek") {
                    theme = window.matchMedia("(prefers-color-scheme: dark)").matches ? "geek" : "classroom";
                }
                document.documentElement.setAttribute("data-theme", theme);

                var preload = document.createElement("link");
                preload.rel = "preload";
                preload.as = "font";
                preload.type = "font/woff2";
                preload.crossOrigin = "anonymous";
                preload.href = heroFonts[theme];
                document.head.appendChild(preload);
            })();
        </script>
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />

        <title>{title}</title>
        <meta name="description" content={description} />

        <link rel="canonical" href={canonicalUrl} />
        {noindex && <meta name="robots" content="noindex" />}
        {!noindex && alternates.map(({ hreflang, href }) => <link rel="alternate" hreflang={hreflang} href={href} />)}
        {!noindex && <link rel="alternate" hreflang="x-default" href={new URL(homePaths.es, Astro.site).href} />}
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" sizes="32x32" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
        <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f5f3ee" />
        <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0d1117" />
        <link rel="sitemap" href="/sitemap-index.xml" />

        <!-- Open Graph -->
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="website" />
        <meta property="og:locale" content={seo.ogLocale} />
        <meta property="og:locale:alternate" content={alternateLocale} />
        <meta property="og:url" content={canonicalUrl} />
        <meta property="og:image" content={ogImageUrl} />

        <!-- Twitter -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImageUrl} />

        <meta name="generator" content={Astro.generator} />

        <slot name="head" />
    </head>
    <body class="bg-primary text-fg font-body overflow-x-hidden">
        <slot />
        <slot name="scripts" />
    </body>
</html>
