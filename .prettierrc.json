{
  "plugins": ["prettier-plugin-astro"],
  "printWidth": 120,
  "tabWidth": 4,
  "endOfLine": "lf",
  "overrides": [
    { "files": "*.astro", "options": { "parser": "astro" } },
    { "files": ["*.json", "*.yml", "*.yaml"], "options": { "tabWidth": 2 } },
    { "files": "*.md", "options": { "tabWidth": 2, "proseWrap": "preserve" } }
  ]
}
